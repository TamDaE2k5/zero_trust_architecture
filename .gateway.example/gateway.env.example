POSTGRES_PASSWORD=demo_postgres_random_secret_hex24
GATEWAY_DB_PASSWORD=demo_gateway_db_random_secret_hex24
GATEWAY_JWT_SECRET=demo_jwt_hmac_secret_at_least_32_characters_long
GATEWAY_PROXY_SECRET=demo_internal_proxy_secret_at_least_32_characters_long
OFFICE_NETWORKS=127.0.0.0/8,::1/128,10.0.0.0/8,192.168.0.0/16
