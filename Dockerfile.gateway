FROM python:3.12.10-slim
WORKDIR /project
COPY requirements-lock.txt requirements-gateway.txt ./
RUN pip install --no-cache-dir -r requirements-lock.txt -r requirements-gateway.txt
COPY . .
RUN pip install --no-cache-dir --no-deps .
CMD ["uvicorn", "app.gateway.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log"]
